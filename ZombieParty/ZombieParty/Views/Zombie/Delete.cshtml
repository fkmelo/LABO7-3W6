@model ZombieParty.Models.ZombieVM
@{
    ViewData["Title"] = "Delete";
}
<h1>Delete</h1>
<h4>Zombie</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <div class="row p-3 ">
            <form asp-action="Delete">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group row">
                    <div class="col-4">
                        <label asp-for="@Model.Zombie.Name" class="control-label"></label>
                    </div>
                    <div class="col-8">
                        <input asp-for="@Model.Zombie.Name" class="form-control"  disabled/>
                        <span asp-validation-for="@Model.Zombie.Name" class="text-danger"></span>
                    </div>
                </div>
                
                <div class="form-group">
                    <input type="submit" value="Delete" asp-controller="zombie" asp-action="DeletePost" asp-route-id="@Model.Zombie.Id" class="btn btn-primary" />
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
